<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- F-83/C4 (Hari-7): SearchTest dipindah KELUAR dari tests/Feature (bukan
             cuma sub-folder) supaya Pest.php bisa mendaftarkan test case class yang
             beda (DatabaseMigrations, bukan RefreshDatabase) tanpa tabrakan binding.
             Pest menolak 2 registrasi Tests\TestCase::class yang overlap untuk file
             yang sama, dan RefreshDatabase+DatabaseMigrations tidak bisa dipakai
             bersamaan di 1 class: keduanya redeclare refreshTestDatabase(), jadi
             fatal trait method collision. Lihat tests/Pest.php. -->
        <testsuite name="Search">
            <directory>tests/Search</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- F-83 (Hari-7): MySQL, BUKAN sqlite. sqlite lenient (LIKE fallback,
             enum jadi TEXT, tanpa FULLTEXT) menyembunyikan bug yang cuma muncul di
             produksi (MATCH AGAINST, collation, FIELD(), json). Host/port/user/pass
             TIDAK dioverride di sini -> ikut .env (server MySQL dev yang sama),
             cuma DB_DATABASE beda supaya data test tidak pernah menyentuh DB dev. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="task_management_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
